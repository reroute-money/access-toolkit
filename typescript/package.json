    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.10.6",
    "@rstest/core": "^0.10.6",
    "@types/node": "^24.13.3",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "private": false,
  "dependencies": {
    "axios": "^1.20.0",
    "es-toolkit": "^1.52.0"
